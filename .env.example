# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique (anon ou « publishable »). Peut être exposée au navigateur : la sécurité repose sur la RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur (service_role ou « secret »). JAMAIS exposée au navigateur, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# URL publique de l'application (liens des e-mails de confirmation et de réinitialisation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Page vitrine des composants (/design) : désactivée en production sauf si "1".
NEXT_PUBLIC_ENABLE_DESIGN=0
# Indexation par les moteurs : laisser à 0 en préproduction et en bêta privée.
NEXT_PUBLIC_ALLOW_INDEXING=0
# Préproduction : rideau HTTP Basic sur toutes les pages, format identifiant:motdepasse (12 caractères minimum au total).
# Laisser vide en local. Ne remplace pas l'invitation en base (supabase/migrations/20261001000000_beta_access.sql).
BETA_BASIC_AUTH=
